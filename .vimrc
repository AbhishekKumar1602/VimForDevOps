" Minimal, plugin-free Vim configuration for DevOps practice.
" Test with: vim -u .vimrc practice/practice.txt

set nocompatible
set number
set hidden
set incsearch
set hlsearch
set ignorecase
set smartcase
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set autoindent
set wildmenu
set backspace=indent,eol,start

syntax on
filetype detection on
